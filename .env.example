# ---------------------------------------------------------------------------
# Produção (VPS). Copie para /opt/your-tab/.env — NUNCA versionar.
# Lido pelo docker compose (interpolação) e pela API (env_file).
# Em desenvolvimento a API usa backend/.env (ver backend/.env.example).
# ---------------------------------------------------------------------------

# DOMÍNIO PÚBLICO (O DNS PRECISA APONTAR PARA A VPS ANTES DE SUBIR: O CADDY
# DO EDGE EMITE O CERTIFICADO NO PRIMEIRO ACESSO). EX.: tab.meudominio.com
YOURTAB_DOMAIN=

MONGO_DB=tab-builder

# CLIENT ID DO OAUTH DO GOOGLE (ORIGEM AUTORIZADA: https://$YOURTAB_DOMAIN).
# VAZIO = LOGIN DESLIGADO
GOOGLE_CLIENT_ID=

# SEGREDO DO COOKIE DE SESSÃO (MÍNIMO 32 CARACTERES): openssl rand -base64 48
JWT_SECRET=
