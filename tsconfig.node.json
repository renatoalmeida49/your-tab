{
  "extends": "@vue/tsconfig/tsconfig.json",
  "include": ["vite.config.*", "playwright.config.*", "tests/**/*"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "allowJs": true
  }
}
